{
  "name": "consulta-medicamentos",
  "private": true,
  "version": "0.1.0",
  "description": "POC event-driven: consulta -> receita -> venda -> pedido -> pagamento -> NF -> entrega (LocalStack)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml}\"",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml}\"",
    "test": "node --test packages/*/test/*.test.js services/*/test/*.test.js",
    "validate": "npm run lint && npm run format:check && npm test",
    "up": "docker compose up -d --build",
    "down": "docker compose down -v",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3"
  }
}
